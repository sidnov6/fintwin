{
  "components": {
    "schemas": {
      "BriefBody": {
        "properties": {
          "language": {
            "default": "de",
            "enum": [
              "de",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "selected_run_ids": {
            "items": {
              "type": "string"
            },
            "title": "Selected Run Ids",
            "type": "array"
          }
        },
        "title": "BriefBody",
        "type": "object"
      },
      "ChildGoalBody": {
        "properties": {
          "annual_return": {
            "anyOf": [
              {
                "maximum": 0.3,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Annual Return"
          },
          "current_savings": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Current Savings"
          },
          "target_amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Target Amount"
          },
          "years": {
            "exclusiveMinimum": 0.0,
            "maximum": 30.0,
            "title": "Years",
            "type": "integer"
          }
        },
        "required": [
          "target_amount",
          "current_savings",
          "years",
          "annual_return"
        ],
        "title": "ChildGoalBody",
        "type": "object"
      },
      "CopilotBody": {
        "properties": {
          "language": {
            "default": "de",
            "enum": [
              "de",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "question": {
            "maxLength": 1000,
            "minLength": 2,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "CopilotBody",
        "type": "object"
      },
      "FactProposalBody": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "typed_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Typed Value"
          }
        },
        "required": [
          "path",
          "typed_value"
        ],
        "title": "FactProposalBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MortgageBody": {
        "properties": {
          "annual_nominal_rate": {
            "anyOf": [
              {
                "maximum": 0.2,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Annual Nominal Rate"
          },
          "monthly_special_repayment": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0",
            "title": "Monthly Special Repayment"
          },
          "principal": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Principal"
          },
          "remaining_months": {
            "exclusiveMinimum": 0.0,
            "maximum": 600.0,
            "title": "Remaining Months",
            "type": "integer"
          },
          "scenario_start_date": {
            "default": "2027-11-01",
            "format": "date",
            "title": "Scenario Start Date",
            "type": "string"
          }
        },
        "required": [
          "principal",
          "annual_nominal_rate",
          "remaining_months"
        ],
        "title": "MortgageBody",
        "type": "object"
      },
      "RetirementBody": {
        "properties": {
          "annual_fee": {
            "anyOf": [
              {
                "maximum": 0.2,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Annual Fee"
          },
          "annual_inflation": {
            "anyOf": [
              {
                "maximum": 0.2,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Annual Inflation"
          },
          "annual_nominal_return": {
            "anyOf": [
              {
                "maximum": 0.5,
                "minimum": -0.5,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Annual Nominal Return"
          },
          "current_assets": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Current Assets"
          },
          "expected_net_pension_income": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Net Pension Income"
          },
          "monthly_contribution": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Monthly Contribution"
          },
          "target_retirement_spending": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Target Retirement Spending"
          },
          "withdrawal_rate": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 0.2,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Withdrawal Rate"
          },
          "years_to_retirement": {
            "exclusiveMinimum": 0.0,
            "maximum": 60.0,
            "title": "Years To Retirement",
            "type": "integer"
          }
        },
        "required": [
          "current_assets",
          "monthly_contribution",
          "years_to_retirement",
          "annual_nominal_return",
          "annual_fee",
          "annual_inflation",
          "target_retirement_spending",
          "withdrawal_rate"
        ],
        "title": "RetirementBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
