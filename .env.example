# Current Next static + Node/SQLite application. NO actual secrets belong here.
# Copy to private .env for start:production; pnpm demo ignores paid configuration.
FINTWIN_DEMO_PASSPHRASE=
PORT=8787
FINTWIN_HOST=127.0.0.1
# Optional: skip the passphrase ONLY on a loopback-bound, same-origin local host.
# Never use this with a tunnel, public origin, reverse proxy, or network binding.
FINTWIN_LOCAL_OPEN=0
FINTWIN_DB=data/local.sqlite
# Required behind an HTTPS proxy; exactly the visible origin, no path.
FINTWIN_PUBLIC_ORIGIN=
# Optional, exact separate frontend origin for development. Same-origin preferred.
FINTWIN_ALLOWED_ORIGIN=
NEXT_PUBLIC_API_URL=

# Safe defaults. Key presence is NOT authorization.
FINTWIN_ALLOW_PAID=0
FINTWIN_VOICE_MODE=text
FINTWIN_SESSION_BUDGET_USD=25
FINTWIN_TOTAL_BUDGET_USD=40
FINTWIN_BUDGET_WINDOW=interview-2026-09

# OpenAI is primary for text, transcription, speech and Realtime when configured.
# Key presence does not fund the API account. No secrets in this example.
# Realtime candidate; activate only for authorized device tests, then rehearsal.
# Requires the Node host; the worker-only bundle has no Node sideband.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4
# Fast conversational default. Calculations still execute in application tools.
OPENAI_REASONING_EFFORT=none
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
FINTWIN_REALTIME_MAX_SECONDS=300
FINTWIN_REALTIME_IDLE_SECONDS=90
FINTWIN_REALTIME_MAX_RESPONSES=30
FINTWIN_REALTIME_RESERVE_USD=2
# Longer sessions require an explicit allowance: max seconds 3300 (55 minutes),
# max idle 600 seconds, max responses 360. Reconnect manually for long rehearsals.

# Custom text wins over OpenAI/Groq; all three are required together.
# Without custom text, OpenAI errors may use Groq; responses label that fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2000
LLM_TOKEN_FIELD=max_tokens
LLM_ALLOW_TEMPERATURE=0
LLM_REASONING_EFFORT=medium
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Optional chained fallback. Choose FINTWIN_VOICE_MODE=chained explicitly.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# Read-only preflight / opt-in smoke target, not a browser environment variable.
FINTWIN_CHECK_URL=http://127.0.0.1:8787
